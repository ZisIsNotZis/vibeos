{
  "id": "google.com",
  "title": "Google",
  "kind": "surface",
  "status": "ready",
  "surface": {
    "heading": "Google",
    "body": "Search the imagined web from a familiar local search page. Results stay inside VibeOS.",
    "fields": [
      { "id": "search", "label": "Search Google", "placeholder": "Search Google" }
    ],
    "controls": [
      {
        "id": "search-submit",
        "label": "Google Search",
        "intent": {
          "type": "navigate_browser",
          "appId": "browser",
          "url": "/google.com/search?q={search}",
          "mode": "search_results"
        }
      },
      {
        "id": "back",
        "label": "Back to new tab",
        "intent": {
          "type": "open_surface",
          "appId": "browser",
          "route": "/"
        }
      }
    ]
  },
  "children": []
}
